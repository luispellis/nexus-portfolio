# Frontend — Vercel receives only this public API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Backend — placeholders only; no secrets here.
FRONTEND_ORIGIN=http://localhost:3000
CONTACT_RECIPIENT_EMAIL=your-recipient@example.com
CONTACT_SENDER_EMAIL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Railway supplies PORT. 8080 is the local fallback configured by the API.
PORT=8080
